# Salin file ini menjadi .env lalu isi nilainya.
# JANGAN commit file .env yang sudah terisi ke GitHub.

# Mode aplikasi: gunakan "production" saat hosting.
NODE_ENV=production

# Port aplikasi. Di Railway/Render/dll biasanya diisi otomatis oleh platform.
PORT=3000

# Kunci rahasia session. WAJIB diisi acak & panjang saat production.
# Contoh membuat: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=ganti-dengan-string-acak-panjang

# Koneksi database Supabase (PostgreSQL).
# Ambil dari Supabase: Project Settings -> Database -> Connection string (URI).
# Ganti [YOUR-PASSWORD] dengan password database Supabase milikmu.
DATABASE_URL=postgresql://postgres.yrmwcfmudojghkvycomm:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# Nama schema tempat semua tabel SIGAP disimpan (default: sigap).
PG_SCHEMA=sigap

# Supabase Storage (untuk file & gambar upload).
# SUPABASE_URL: Project Settings -> API -> Project URL.
# SUPABASE_SERVICE_ROLE_KEY: Project Settings -> API -> service_role (RAHASIA!).
SUPABASE_URL=https://yrmwcfmudojghkvycomm.supabase.co
SUPABASE_SERVICE_ROLE_KEY=ganti-dengan-service-role-key
SUPABASE_BUCKET=uploads

# Hanya untuk migrasi file satu kali (tarik file lama dari app live):
# APP_URL=https://sigap.pasmansa.or.id
# APP_LOGIN_ID=admin
# APP_LOGIN_PASS=password-admin-kamu

# Lokasi file SQLite lama (hanya dipakai saat migrasi data satu kali).
# SQLITE_PATH=./data/sigap.db
