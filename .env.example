# Salin file ini menjadi .env lalu isi nilainya.
# JANGAN commit file .env yang sudah terisi ke GitHub.

# Mode aplikasi: gunakan "production" saat hosting.
NODE_ENV=production

# Port aplikasi. Di Railway/Render/dll biasanya diisi otomatis oleh platform,
# jadi biarkan kosong atau samakan dengan yang diminta Domain
pasmansa.or.id
