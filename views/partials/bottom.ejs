      </main>
      <footer class="footer"><%- copyright %></footer>
    </div>
  </div>
  <script src="/js/main.js"></script>
  <% if (typeof liveReload !== 'undefined' && liveReload) { %>
    <script>
      // Load live reload once (DOM append, not document.write) so Turbo visits
      // don't wipe the page.
      if (!window.__lrLoaded) {
        window.__lrLoaded = true;
        var lr = document.createElement('script');
        lr.src = '//' + location.hostname + ':35729/livereload.js?snipver=1';
        document.head.appendChild(lr);
      }
    </script>
  <% } %>
</body>
</html>
