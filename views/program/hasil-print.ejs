<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <title>Hasil Program Kerja - <%= bidang.label %></title>
  <link rel="stylesheet" href="/css/print.css" />
  <style>@page { size: A4 landscape; margin: 12mm; }</style>
</head>
<body onload="window.print()">
  <div class="print-toolbar">
    <button onclick="window.print()">Print / Save PDF</button>
    <button onclick="window.close()">Tutup</button>
  </div>
  <div class="print-header">
    <div class="org">Paskibra SMA Negeri 1 Jeneponto</div>
    <div class="doc">Hasil Program Kerja - <%= bidang.label %></div>
  </div>
  <hr class="print-rule" />
  <table>
    <thead>
      <tr>
        <th style="width:30px">No.</th><th>Nama Kegiatan</th><th>Tanggal</th><th>Target</th><th>Hasil</th><th>Penanggung Jawab</th>
      </tr>
    </thead>
    <tbody>
      <% if (rows.length === 0) { %>
        <tr><td colspan="6" class="text-center">Tidak ada data.</td></tr>
      <% } %>
      <% rows.forEach(function(r, i) { %>
        <tr>
          <td class="text-center"><%= i + 1 %></td>
          <td><%= r.nama_kegiatan %></td>
          <td><%= fmt.formatRentang(r.tanggal_mulai, r.tanggal_selesai) %></td>
          <td><%= r.target || '-' %></td>
          <td><%= r.hasil || '-' %></td>
          <td><%= r.penanggung_jawab || '-' %></td>
        </tr>
      <% }); %>
    </tbody>
  </table>
</body>
</html>
