<%- include('../partials/top') %>
<% const writable = canWrite('sertifikat'); %>

<form class="toolbar" method="GET" action="/sertifikat" data-noguard>
  <div class="grow">
    <input type="text" name="q" value="<%= filters.q %>" placeholder="Cari nomor, perihal, atas nama..." />
  </div>
  <select name="bulan" onchange="this.form.submit()">
    <option value="">Semua Bulan</option>
    <% fmt.MONTHS.forEach(function(m, i) { %>
      <option value="<%= i + 1 %>" <%= String(filters.bulan) === String(i + 1) ? 'selected' : '' %>><%= m %></option>
    <% }); %>
  </select>
  <select name="tahun" onchange="this.form.submit()">
    <option value="">Semua Tahun</option>
    <% for (let y = new Date().getFullYear(); y >= 2020; y--) { %>
      <option value="<%= y %>" <%= String(filters.tahun) === String(y) ? 'selected' : '' %>><%= y %></option>
    <% } %>
  </select>
  <button type="submit" class="btn">Cari</button>
  <div class="toolbar-right">
    <a class="btn" target="_blank" href="/sertifikat/print?<%= new URLSearchParams(filters).toString() %>">
      <%- include('../partials/icon', { name: 'printer' }) %> Cetak Data
    </a>
    <% if (writable) { %>
      <button type="button" class="btn btn-primary" onclick="openAdd()">
        <%- include('../partials/icon', { name: 'plus' }) %> Tambah Sertifikat
      </button>
    <% } %>
  </div>
</form>

<div class="card">
  <div class="table-wrap">
    <table>
      <thead>
        <tr><th>No.</th><th>Nomor Sertifikat</th><th>Tanggal</th><th>Perihal</th><th>Atas Nama</th><th>File</th><th class="text-center">Aksi</th></tr>
      </thead>
      <tbody>
        <% if (rows.length === 0) { %>
          <tr><td colspan="7" class="empty">Belum ada data sertifikat.</td></tr>
        <% } %>
        <% rows.forEach(function(r, i) { %>
          <tr>
            <td><%= i + 1 %></td>
            <td><span class="badge badge-primary"><%= r.nomor_sertifikat %></span></td>
            <td class="nowrap"><%= fmt.formatTanggal(r.tanggal) %></td>
            <td><%= r.perihal %></td>
            <td><%= r.penerima %></td>
            <td>
              <% if (r.file_path) { %>
                <div class="action-group">
                  <a class="btn btn-icon btn-sm" title="Preview" target="_blank" href="/file/<%= r.file_path %>"><%- include('../partials/icon', { name: 'eye' }) %></a>
                  <a class="btn btn-icon btn-sm" title="Download" href="/file/<%= r.file_path %>?download=1"><%- include('../partials/icon', { name: 'download' }) %></a>
                </div>
              <% } else { %><span class="muted">-</span><% } %>
            </td>
            <td>
              <div class="action-group" style="justify-content:center;">
                <button class="btn btn-icon btn-sm" title="Detail" onclick='showDetail(<%- JSON.stringify(r.id) %>)'><%- include('../partials/icon', { name: 'eye' }) %></button>
                <% if (writable) { %>
                  <button class="btn btn-icon btn-sm" title="Edit" onclick='openEdit(<%- JSON.stringify(r) %>)'><%- include('../partials/icon', { name: 'edit' }) %></button>
                  <form method="POST" action="/sertifikat/<%= r.id %>/delete" data-noguard style="display:inline" onsubmit="return confirmDelete('Arsipkan sertifikat ini?')">
                    <button class="btn btn-icon btn-sm btn-danger" title="Hapus"><%- include('../partials/icon', { name: 'trash' }) %></button>
                  </form>
                <% } %>
              </div>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>

<% if (writable) { %>
<div class="modal-backdrop" id="formModal">
  <div class="modal modal-lg">
    <div class="modal-header">
      <span class="modal-title" id="formTitle">Tambah Sertifikat</span>
      <button class="modal-close" onclick="closeModal('formModal')"><%- include('../partials/icon', { name: 'x' }) %></button>
    </div>
    <form id="sertifikatForm" method="POST" action="/sertifikat" enctype="multipart/form-data">
      <div class="modal-body">
        <div class="form-row">
          <div class="form-group">
            <label>Nomor Sertifikat <span class="req">*</span></label>
            <input type="text" name="nomor_sertifikat" id="f_nomor" required />
            <div class="form-hint">Harus unik.</div>
          </div>
          <div class="form-group">
            <label>Tanggal <span class="req">*</span></label>
            <input type="date" name="tanggal" id="f_tanggal" required />
          </div>
        </div>
        <div class="form-group">
          <label>Perihal <span class="req">*</span></label>
          <input type="text" name="perihal" id="f_perihal" required />
        </div>
        <div class="form-group">
          <label>Atas Nama <span class="req">*</span></label>
          <input type="text" name="penerima" id="f_penerima" required />
        </div>
        <div class="form-group">
          <label>File Sertifikat (PDF / Gambar)</label>
          <input type="file" name="file" accept="application/pdf,image/*" />
          <div class="form-hint">PDF atau gambar (JPG, PNG, WEBP), maksimal 5 MB. Kosongkan jika tidak mengubah file.</div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn" onclick="closeModal('formModal')">Batal</button>
        <button type="submit" class="btn btn-primary">Simpan Data</button>
      </div>
    </form>
  </div>
</div>
<% } %>

<div class="modal-backdrop" id="detailModal">
  <div class="modal">
    <div class="modal-header">
      <span class="modal-title">Detail Sertifikat</span>
      <button class="modal-close" onclick="closeModal('detailModal')"><%- include('../partials/icon', { name: 'x' }) %></button>
    </div>
    <div class="modal-body"><dl class="detail-list" id="detailBody"></dl></div>
    <div class="modal-footer"><button class="btn" onclick="closeModal('detailModal')">Tutup</button></div>
  </div>
</div>

<script>
  function openAdd() {
    document.getElementById('formTitle').textContent = 'Tambah Sertifikat';
    const f = document.getElementById('sertifikatForm');
    f.action = '/sertifikat'; f.reset();
    openModal('formModal');
  }
  function openEdit(r) {
    document.getElementById('formTitle').textContent = 'Edit Sertifikat';
    const f = document.getElementById('sertifikatForm');
    f.action = '/sertifikat/' + r.id + '/edit';
    f.f_nomor.value = r.nomor_sertifikat; f.f_tanggal.value = r.tanggal;
    f.f_perihal.value = r.perihal; f.f_penerima.value = r.penerima;
    openModal('formModal');
  }
  async function showDetail(id) {
    try {
      const r = await fetchJSON('/sertifikat/' + id + '/detail');
      let html = row('Nomor Sertifikat', r.nomor_sertifikat) + row('Tanggal', r.tanggal) +
        row('Perihal', r.perihal) + row('Atas Nama', r.penerima);
      if (r.file_path) html += row('File', '<a target="_blank" href="/file/' + r.file_path + '">Lihat File</a>');
      document.getElementById('detailBody').innerHTML = html;
      openModal('detailModal');
    } catch (e) { alert(e.message); }
  }
  function row(k, v) { return '<div class="detail-item"><dt>' + k + '</dt><dd>' + v + '</dd></div>'; }
</script>

<%- include('../partials/bottom') %>
