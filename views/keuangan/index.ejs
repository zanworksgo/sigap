<%- include('../partials/top') %>
<% const writable = canWrite(moduleKey); %>

<form class="toolbar" method="GET" action="/<%= basePath %>" data-noguard>
  <div class="grow">
    <input type="text" name="q" value="<%= filters.q %>" placeholder="Cari uraian, kategori, keterangan..." />
  </div>
  <select name="bulan" onchange="this.form.submit()">
    <option value="">Semua Bulan</option>
    <% fmt.MONTHS.forEach(function(m, i) { %>
      <option value="<%= i + 1 %>" <%= String(filters.bulan) === String(i + 1) ? 'selected' : '' %>><%= m %></option>
    <% }); %>
  </select>
  <select name="tahun" onchange="this.form.submit()">
    <option value="">Semua Tahun</option>
    <% for (let y = new Date().getFullYear(); y >= 2020; y--) { %>
      <option value="<%= y %>" <%= String(filters.tahun) === String(y) ? 'selected' : '' %>><%= y %></option>
    <% } %>
  </select>
  <button type="submit" class="btn">Cari</button>
  <div class="toolbar-right">
    <a class="btn" target="_blank" href="/<%= basePath %>/print?<%= new URLSearchParams(filters).toString() %>">
      <%- include('../partials/icon', { name: 'printer' }) %> Cetak Data
    </a>
    <% if (writable) { %>
      <button type="button" class="btn btn-primary" onclick="openAdd()">
        <%- include('../partials/icon', { name: 'plus' }) %> Tambah <%= jenis %>
      </button>
    <% } %>
  </div>
</form>

<div class="stat-grid" style="grid-template-columns:repeat(auto-fill,minmax(240px,1fr));">
  <div class="stat-card">
    <div class="stat-icon"><%- include('../partials/icon', { name: jenis === 'Pemasukan' ? 'trending-up' : 'trending-down' }) %></div>
    <div class="stat-label">Total <%= jenis %> (sesuai filter)</div>
    <div class="stat-value" style="font-size:20px;"><%= fmt.formatRupiah(total) %></div>
  </div>
</div>

<div class="card">
  <div class="table-wrap">
    <table>
      <thead>
        <tr><th>No.</th><th>Tanggal</th><th>Uraian</th><th>Kategori</th><th class="text-right">Nominal</th><th>Bukti</th><th class="text-center">Aksi</th></tr>
      </thead>
      <tbody>
        <% if (rows.length === 0) { %>
          <tr><td colspan="7" class="empty">Belum ada data <%= jenis.toLowerCase() %>.</td></tr>
        <% } %>
        <% rows.forEach(function(r, i) { %>
          <tr>
            <td><%= i + 1 %></td>
            <td class="nowrap"><%= fmt.formatTanggal(r.tanggal) %></td>
            <td><%= r.uraian %></td>
            <td><%= r.kategori || '-' %></td>
            <td class="text-right mono"><%= fmt.formatRupiah(r.nominal) %></td>
            <td>
              <% if (r.bukti_path) { %>
                <a class="btn btn-icon btn-sm" title="Lihat Bukti" target="_blank" href="/file/<%= r.bukti_path %>"><%- include('../partials/icon', { name: 'eye' }) %></a>
              <% } else { %><span class="muted">-</span><% } %>
            </td>
            <td>
              <div class="action-group" style="justify-content:center;">
                <button class="btn btn-icon btn-sm" title="Detail" onclick='showDetail(<%- JSON.stringify(r.id) %>)'><%- include('../partials/icon', { name: 'eye' }) %></button>
                <% if (writable) { %>
                  <button class="btn btn-icon btn-sm" title="Edit" onclick='openEdit(<%- JSON.stringify(r) %>)'><%- include('../partials/icon', { name: 'edit' }) %></button>
                  <form method="POST" action="/<%= basePath %>/<%= r.id %>/delete" data-noguard style="display:inline" onsubmit="return confirmDelete('Hapus data ini?')">
                    <button class="btn btn-icon btn-sm btn-danger" title="Hapus"><%- include('../partials/icon', { name: 'trash' }) %></button>
                  </form>
                <% } %>
              </div>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>

<% if (writable) { %>
<div class="modal-backdrop" id="formModal">
  <div class="modal">
    <div class="modal-header">
      <span class="modal-title" id="formTitle">Tambah <%= jenis %></span>
      <button class="modal-close" onclick="closeModal('formModal')"><%- include('../partials/icon', { name: 'x' }) %></button>
    </div>
    <form id="trxForm" method="POST" action="/<%= basePath %>" enctype="multipart/form-data">
      <div class="modal-body">
        <div class="form-row">
          <div class="form-group">
            <label>Tanggal <span class="req">*</span></label>
            <input type="date" name="tanggal" id="t_tanggal" required />
          </div>
          <div class="form-group">
            <label>Nominal (Rp) <span class="req">*</span></label>
            <input type="number" name="nominal" id="t_nominal" min="0" step="1" required />
          </div>
        </div>
        <div class="form-group">
          <label>Uraian <span class="req">*</span></label>
          <input type="text" name="uraian" id="t_uraian" required />
        </div>
        <div class="form-group">
          <label>Kategori</label>
          <input type="text" name="kategori" id="t_kategori" placeholder="misal: Iuran, Operasional" />
        </div>
        <div class="form-group">
          <label>Keterangan</label>
          <textarea name="keterangan" id="t_keterangan"></textarea>
        </div>
        <div class="form-group">
          <label>Bukti (PDF, opsional)</label>
          <input type="file" name="bukti" accept="application/pdf" />
          <div class="form-hint">Hanya PDF, maksimal 5 MB.</div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn" onclick="closeModal('formModal')">Batal</button>
        <button type="submit" class="btn btn-primary">Simpan Data</button>
      </div>
    </form>
  </div>
</div>
<% } %>

<div class="modal-backdrop" id="detailModal">
  <div class="modal">
    <div class="modal-header">
      <span class="modal-title">Detail <%= jenis %></span>
      <button class="modal-close" onclick="closeModal('detailModal')"><%- include('../partials/icon', { name: 'x' }) %></button>
    </div>
    <div class="modal-body"><dl class="detail-list" id="detailBody"></dl></div>
    <div class="modal-footer"><button class="btn" onclick="closeModal('detailModal')">Tutup</button></div>
  </div>
</div>

<script>
  const BASE = '/<%= basePath %>';
  function openAdd() {
    document.getElementById('formTitle').textContent = 'Tambah <%= jenis %>';
    const f = document.getElementById('trxForm');
    f.action = BASE; f.reset();
    openModal('formModal');
  }
  function openEdit(r) {
    document.getElementById('formTitle').textContent = 'Edit <%= jenis %>';
    const f = document.getElementById('trxForm');
    f.action = BASE + '/' + r.id + '/edit';
    f.t_tanggal.value = r.tanggal; f.t_nominal.value = r.nominal;
    f.t_uraian.value = r.uraian; f.t_kategori.value = r.kategori || '';
    f.t_keterangan.value = r.keterangan || '';
    openModal('formModal');
  }
  async function showDetail(id) {
    try {
      const r = await fetchJSON(BASE + '/' + id + '/detail');
      let html = row('Tanggal', r.tanggal) + row('Uraian', r.uraian) + row('Kategori', r.kategori || '-') +
        row('Nominal', new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', minimumFractionDigits: 0 }).format(r.nominal)) +
        row('Keterangan', r.keterangan || '-');
      if (r.bukti_path) html += row('Bukti', '<a target="_blank" href="/file/' + r.bukti_path + '">Lihat PDF</a>');
      document.getElementById('detailBody').innerHTML = html;
      openModal('detailModal');
    } catch (e) { alert(e.message); }
  }
  function row(k, v) { return '<div class="detail-item"><dt>' + k + '</dt><dd>' + v + '</dd></div>'; }
</script>

<%- include('../partials/bottom') %>
