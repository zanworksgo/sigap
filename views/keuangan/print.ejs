<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <title>Data <%= jenis %></title>
  <link rel="stylesheet" href="/css/print.css" />
</head>
<body onload="window.print()">
  <div class="print-toolbar">
    <button onclick="window.print()">Print / Save PDF</button>
    <button onclick="window.close()">Tutup</button>
  </div>
  <div class="print-header">
    <div class="org">Paskibra SMA Negeri 1 Jeneponto</div>
    <div class="doc">Data <%= jenis %></div>
    <div class="periode">Periode: <%= fmt.periodeLabel(filters.bulan, filters.tahun) %></div>
  </div>
  <hr class="print-rule" />
  <table>
    <thead>
      <tr><th style="width:36px">No.</th><th>Tanggal</th><th>Uraian</th><th>Kategori</th><th class="text-right">Nominal</th></tr>
    </thead>
    <tbody>
      <% if (rows.length === 0) { %>
        <tr><td colspan="5" class="text-center">Tidak ada data.</td></tr>
      <% } %>
      <% rows.forEach(function(r, i) { %>
        <tr>
          <td class="text-center"><%= i + 1 %></td>
          <td><%= fmt.formatTanggal(r.tanggal) %></td>
          <td><%= r.uraian %></td>
          <td><%= r.kategori || '-' %></td>
          <td class="text-right"><%= fmt.formatRupiah(r.nominal) %></td>
        </tr>
      <% }); %>
    </tbody>
    <tfoot>
      <tr><td colspan="4" class="text-right">Total</td><td class="text-right"><%= fmt.formatRupiah(total) %></td></tr>
    </tfoot>
  </table>
</body>
</html>
