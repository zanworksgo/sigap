<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> · SIGAP</title>
  <link rel="stylesheet" href="/css/style.css" />
  <script>(function () { var t = localStorage.getItem('sigap-theme'); if (t) document.documentElement.setAttribute('data-theme', t); })();</script>
</head>
<body>
  <div class="login-wrap">
    <div class="login-card" style="text-align:center;">
      <div style="font-size:56px;font-weight:800;color:var(--primary);"><%= code %></div>
      <h1 style="margin:8px 0;font-size:20px;"><%= title %></h1>
      <p class="muted" style="margin-bottom:20px;"><%= message %></p>
      <a href="/dashboard" class="btn btn-primary" style="width:100%;justify-content:center;">Kembali ke Dashboard</a>
    </div>
  </div>
</body>
</html>
