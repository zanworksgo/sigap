<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <title>Keuangan <%= panitia.label %></title>
  <link rel="stylesheet" href="/css/print.css" />
</head>
<body onload="window.print()">
  <div class="print-toolbar">
    <button onclick="window.print()">Print / Save PDF</button>
    <button onclick="window.close()">Tutup</button>
  </div>
  <div class="print-header">
    <div class="org">Paskibra SMA Negeri 1 Jeneponto</div>
    <div class="doc">Laporan Keuangan Kepanitiaan <%= panitia.label %></div>
    <div class="periode">Periode: <%= fmt.periodeLabel(filters.bulan, filters.tahun) %></div>
  </div>
  <hr class="print-rule" />
  <table>
    <thead>
      <tr><th style="width:36px">No.</th><th>Tanggal</th><th>Jenis</th><th>Uraian</th><th class="text-right">Nominal</th></tr>
    </thead>
    <tbody>
      <% if (rows.length === 0) { %>
        <tr><td colspan="5" class="text-center">Tidak ada transaksi.</td></tr>
      <% } %>
      <% rows.forEach(function(r, i) { %>
        <tr>
          <td class="text-center"><%= i + 1 %></td>
          <td><%= fmt.formatTanggal(r.tanggal) %></td>
          <td><%= r.jenis %></td>
          <td><%= r.uraian || '-' %></td>
          <td class="text-right"><%= fmt.formatRupiah(r.nominal) %></td>
        </tr>
      <% }); %>
    </tbody>
  </table>

  <table class="print-summary">
    <tr><td>Alokasi dari Kas Umum</td><td class="text-right"><%= fmt.formatRupiah(sum.Alokasi) %></td></tr>
    <tr><td>Pemasukan Panitia</td><td class="text-right"><%= fmt.formatRupiah(sum.Pemasukan) %></td></tr>
    <tr><td>Pengeluaran</td><td class="text-right"><%= fmt.formatRupiah(sum.Pengeluaran) %></td></tr>
    <tr><td>Dikembalikan ke Kas Umum</td><td class="text-right"><%= fmt.formatRupiah(sum.Pengembalian) %></td></tr>
    <tr class="total-row"><td>Saldo Panitia</td><td class="text-right"><%= fmt.formatRupiah(sum.saldo) %></td></tr>
  </table>

  <div class="print-sign">
    <div class="box">
      <div>Jeneponto, <%= fmt.formatTanggal(new Date().toISOString().slice(0,10)) %></div>
      <div>Bendahara</div>
      <div class="space"></div>
      <div>( ........................................ )</div>
    </div>
  </div>
</body>
</html>
