<%- include('../partials/top') %>

<form class="toolbar" method="GET" action="/users" data-noguard>
  <div class="grow">
    <input type="text" name="q" value="<%= filters.q %>" placeholder="Cari nama, username, atau email..." />
  </div>
  <select name="role" onchange="this.form.submit()">
    <option value="">Semua Role</option>
    <% roles.forEach(function(r) { %>
      <option value="<%= r %>" <%= filters.role === r ? 'selected' : '' %>><%= r %></option>
    <% }); %>
  </select>
  <button type="submit" class="btn">Cari</button>
  <div class="toolbar-right">
    <button type="button" class="btn btn-primary" onclick="openAddUser()">
      <%- include('../partials/icon', { name: 'plus' }) %> Tambah User
    </button>
  </div>
</form>

<div class="card">
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>No.</th><th>Nama</th><th>Username / Email</th><th>Role</th><th>Status</th><th class="text-center">Aksi</th>
        </tr>
      </thead>
      <tbody>
        <% if (users.length === 0) { %>
          <tr><td colspan="6" class="empty">Tidak ada user ditemukan.</td></tr>
        <% } %>
        <% users.forEach(function(u, i) { %>
          <tr>
            <td><%= i + 1 %></td>
            <td><b><%= u.nama %></b></td>
            <td><%= u.username %><% if (u.email) { %><br /><span class="muted"><%= u.email %></span><% } %></td>
            <td><span class="badge badge-muted"><%= u.role %></span></td>
            <td>
              <span class="badge <%= u.status === 'Aktif' ? 'badge-success' : 'badge-danger' %>"><%= u.status %></span>
            </td>
            <td>
              <div class="action-group" style="justify-content:center;">
                <button class="btn btn-icon btn-sm" title="Detail" onclick='showUser(<%- JSON.stringify(u.id) %>)'><%- include('../partials/icon', { name: 'eye' }) %></button>
                <button class="btn btn-icon btn-sm" title="Edit" onclick='editUser(<%- JSON.stringify(u) %>)'><%- include('../partials/icon', { name: 'edit' }) %></button>
                <button class="btn btn-icon btn-sm" title="Reset Password" onclick='resetUser(<%- JSON.stringify({id:u.id,nama:u.nama}) %>)'><%- include('../partials/icon', { name: 'key' }) %></button>
                <form method="POST" action="/users/<%= u.id %>/toggle" data-noguard style="display:inline">
                  <button class="btn btn-icon btn-sm" title="<%= u.status === 'Aktif' ? 'Nonaktifkan' : 'Aktifkan' %>"><%- include('../partials/icon', { name: 'power' }) %></button>
                </form>
              </div>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>

<!-- Add/Edit Modal -->
<div class="modal-backdrop" id="userModal">
  <div class="modal">
    <div class="modal-header">
      <span class="modal-title" id="userModalTitle">Tambah User</span>
      <button class="modal-close" onclick="closeModal('userModal')"><%- include('../partials/icon', { name: 'x' }) %></button>
    </div>
    <form id="userForm" method="POST" action="/users">
      <div class="modal-body">
        <div class="form-group">
          <label>Nama Lengkap <span class="req">*</span></label>
          <input type="text" name="nama" id="u_nama" required />
        </div>
        <div class="form-row">
          <div class="form-group">
            <label>Username <span class="req">*</span></label>
            <input type="text" name="username" id="u_username" required />
          </div>
          <div class="form-group">
            <label>Email</label>
            <input type="email" name="email" id="u_email" />
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label>Role <span class="req">*</span></label>
            <select name="role" id="u_role" required>
              <% roles.forEach(function(r) { %><option value="<%= r %>"><%= r %></option><% }); %>
            </select>
          </div>
          <div class="form-group" id="passGroup">
            <label>Password <span class="req">*</span></label>
            <input type="password" name="password" id="u_password" minlength="6" />
            <div class="form-hint">Minimal 6 karakter.</div>
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn" onclick="closeModal('userModal')">Batal</button>
        <button type="submit" class="btn btn-primary">Simpan Data</button>
      </div>
    </form>
  </div>
</div>

<!-- Detail Modal -->
<div class="modal-backdrop" id="detailModal">
  <div class="modal">
    <div class="modal-header">
      <span class="modal-title">Detail User</span>
      <button class="modal-close" onclick="closeModal('detailModal')"><%- include('../partials/icon', { name: 'x' }) %></button>
    </div>
    <div class="modal-body">
      <dl class="detail-list" id="detailBody"></dl>
    </div>
    <div class="modal-footer"><button class="btn" onclick="closeModal('detailModal')">Tutup</button></div>
  </div>
</div>

<!-- Reset Password Modal -->
<div class="modal-backdrop" id="resetModal">
  <div class="modal">
    <div class="modal-header">
      <span class="modal-title">Reset Password</span>
      <button class="modal-close" onclick="closeModal('resetModal')"><%- include('../partials/icon', { name: 'x' }) %></button>
    </div>
    <form id="resetForm" method="POST">
      <div class="modal-body">
        <p class="muted" style="margin-bottom:12px;">Reset password untuk <b id="resetName"></b></p>
        <div class="form-group">
          <label>Password Baru <span class="req">*</span></label>
          <input type="password" name="password" minlength="6" required />
          <div class="form-hint">Minimal 6 karakter.</div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn" onclick="closeModal('resetModal')">Batal</button>
        <button type="submit" class="btn btn-primary">Reset Password</button>
      </div>
    </form>
  </div>
</div>

<script>
  function openAddUser() {
    document.getElementById('userModalTitle').textContent = 'Tambah User';
    const f = document.getElementById('userForm');
    f.action = '/users';
    f.reset();
    document.getElementById('u_password').required = true;
    document.getElementById('passGroup').style.display = '';
    openModal('userModal');
  }
  function editUser(u) {
    document.getElementById('userModalTitle').textContent = 'Edit User';
    const f = document.getElementById('userForm');
    f.action = '/users/' + u.id + '/edit';
    document.getElementById('u_nama').value = u.nama;
    document.getElementById('u_username').value = u.username;
    document.getElementById('u_email').value = u.email || '';
    document.getElementById('u_role').value = u.role;
    document.getElementById('u_password').required = false;
    document.getElementById('passGroup').style.display = 'none';
    openModal('userModal');
  }
  async function showUser(id) {
    try {
      const u = await fetchJSON('/users/' + id + '/detail');
      document.getElementById('detailBody').innerHTML =
        row('Nama', u.nama) + row('Username', u.username) + row('Email', u.email || '-') +
        row('Role', u.role) + row('Status', u.status) + row('Dibuat', u.created_at);
      openModal('detailModal');
    } catch (e) { alert(e.message); }
  }
  function resetUser(u) {
    document.getElementById('resetName').textContent = u.nama;
    document.getElementById('resetForm').action = '/users/' + u.id + '/reset-password';
    openModal('resetModal');
  }
  function row(k, v) {
    return '<div class="detail-item"><dt>' + k + '</dt><dd>' + v + '</dd></div>';
  }
</script>

<%- include('../partials/bottom') %>
