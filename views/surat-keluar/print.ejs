<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <title>Data Surat Keluar</title>
  <link rel="stylesheet" href="/css/print.css" />
</head>
<body onload="window.print()">
  <div class="print-toolbar">
    <button onclick="window.print()">Print / Save PDF</button>
    <button onclick="window.close()">Tutup</button>
  </div>
  <div class="print-header">
    <div class="org">Paskibra SMA Negeri 1 Jeneponto</div>
    <div class="doc">Data Surat Keluar</div>
    <div class="periode">Periode: <%= fmt.periodeLabel(filters.bulan, filters.tahun) %></div>
  </div>
  <hr class="print-rule" />
  <table>
    <thead>
      <tr><th style="width:36px">No.</th><th>Nomor Surat</th><th>Tanggal</th><th>Perihal</th><th>Ditujukan</th></tr>
    </thead>
    <tbody>
      <% if (rows.length === 0) { %>
        <tr><td colspan="5" class="text-center">Tidak ada data.</td></tr>
      <% } %>
      <% rows.forEach(function(r, i) { %>
        <tr>
          <td class="text-center"><%= i + 1 %></td>
          <td><%= r.nomor_surat %></td>
          <td><%= fmt.formatTanggal(r.tanggal) %></td>
          <td><%= r.perihal %></td>
          <td><%= r.ditujukan %></td>
        </tr>
      <% }); %>
    </tbody>
  </table>
  <div class="print-sign">
    <div class="box">
      <div>Jeneponto, <%= fmt.formatTanggal(new Date().toISOString().slice(0,10)) %></div>
      <div>Sekretaris</div>
      <div class="space"></div>
      <div>( ........................................ )</div>
    </div>
  </div>
</body>
</html>
